# Data & artifacts
/data/
*.npz
*.pt
/results/trajectories/
/results/*.log

# Throwaway/external harness (Kaggle push scripts, pulled kernel outputs) —
# not reproducible from a fresh clone, not meant to be committed.
#
# EXCEPTION added 2026-07-28: the seven 2026-07-26/27 kernel bundles ARE
# committed. They are the only record of how every result marked
# "verified-live on GPU" was produced, and their pulled `out/` directories hold
# both the logs (which contain the printed numbers) and the raw per-position
# latents that D34/D36/D37 rest on. Excluding them would repeat the exact
# failure docs/rigor_audit.md documents: 16 of 18 historical results files have
# no raw data on disk and their conclusions cannot be corrected without a GPU
# re-run. ~55 MB, no single file over 1 MB. The older kaggle_* dirs stay
# ignored — they are full repo copies, not experiments.
/scratch/*
!/scratch/kaggle_precision_gate/
!/scratch/kaggle_jacobian/
!/scratch/kaggle_register/
!/scratch/kaggle_depth/
!/scratch/kaggle_depth_fixed/
!/scratch/kaggle_states/
!/scratch/kaggle_register_depth/
!/scratch/kaggle_readout/
!/scratch/kaggle_baseline/
!/scratch/kaggle_untrained_depth/
!/scratch/kaggle_untrained_baseline/
!/scratch/kaggle_causal/
!/scratch/kaggle_rho_direct/
!/scratch/kaggle_rho_ckpt/
!/scratch/kaggle_rho_ckpt_a/
!/scratch/kaggle_rho_ckpt_b/
!/scratch/kaggle_rho_ckpt_c/
!/scratch/kaggle_rho_ckpt_d/
!/scratch/kaggle_rho_seed_a/
!/scratch/kaggle_rho_seed_b/
!/scratch/kaggle_register_correct/
!/scratch/kaggle_caesar/
!/scratch/kaggle_caesar2/
!/scratch/kaggle_eps_sweep/
!/scratch/kaggle_chatfmt/
!/scratch/kaggle_taskacc/
!/scratch/kaggle_promptdepth/
!/scratch/kaggle_capcontent/
!/scratch/kaggle_memprobe/
!/scratch/kaggle_graded/
!/scratch/kaggle_discourse/
!/scratch/kaggle_geomcorrect/
!/scratch/kaggle_capgraded/
!/scratch/kaggle_headcheck/
!/scratch/kaggle_eps_split/
!/scratch/kaggle_h2rot/
!/scratch/kaggle_battery/
!/scratch/kaggle_b6bank/
!/scratch/kaggle_geomcap/
!/scratch/kaggle_depthacc/
!/scratch/kaggle_lenmatch/
!/scratch/kaggle_marker/
!/scratch/kaggle_h0bank/
!/scratch/kaggle_clrs/
!/scratch/kaggle_patch/
!/scratch/kaggle_census/
# DataSphere bundle: template only, the real cfg.yaml is generated at submit time
# with the WandB key injected and is deliberately NOT committed.
!/scratch/ds_eigen/
!/scratch/ds_bank/
!/scratch/ds_seeds/
# 2026-08-09: these two carry no secrets (no WandB key -- they use the plain
# `env.python.type: manual` recipe), and they produce ledger claims, so the
# producing code is committed for the same reason the kaggle_* bundles are.
!/scratch/ds_qkprobe/
!/scratch/ds_pertoken/
# Recovered 2026-08-09 by `kaggle kernels pull` after the authoring session's
# container was lost before pushing. main.py is the artifact Kaggle actually ran
# (the record D73 rests on); its body.py did not survive, so this bundle cannot
# be rebuilt by build_kernel and is deliberately artifact-only.
!/scratch/kaggle_nonlinear/
!/scratch/_lib/
# within those bundles, keep the harness noise out
/scratch/QUEUE
/scratch/*/poll.sh
/scratch/*/poll*.log
/scratch/*/watch*.log
/scratch/*/main_v1.py
/scratch/*/out/*.html
/scratch/*/out2/*.html
# kaggle_states/out was an incomplete first pull (22 of 48 arrays, no meta.json)
# that raced the transfer; out2 is the complete one and is what the analyses read.
/scratch/kaggle_states/out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
